{
  "name": "viralforge-monorepo",
  "packageManager": "pnpm@11.5.0",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @viralforge/web dev",
    "dev:mobile": "pnpm --filter @viralforge/mobile start",
